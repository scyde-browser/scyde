{
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "90ms",
        "$description": "hover, press"
      },
      "fast": {
        "$value": "140ms",
        "$description": "tooltip, small states, omnibox popover"
      },
      "base": {
        "$value": "200ms",
        "$description": "menu, theme change cross-fade"
      },
      "slow": {
        "$value": "300ms",
        "$description": "sheet, tab switcher"
      },
      "choreo-max": {
        "$value": "420ms",
        "$description": "Upper bound for a whole choreography"
      },
      "reduced": {
        "$value": "120ms",
        "$description": "Reduced motion: every animation becomes an opacity cross-fade of this length"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.23,
          1,
          0.32,
          1
        ],
        "$description": "entrances"
      },
      "in-out": {
        "$value": [
          0.77,
          0,
          0.175,
          1
        ],
        "$description": "on-screen moves"
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "exits (duration x0.7)"
      }
    },
    "exit-factor": {
      "$type": "number",
      "$value": 0.7
    },
    "spring": {
      "$type": "x-spring",
      "$description": "stiffness k=(2pi/response)^2 (mass 1), damping ratio = damping. tools/springs generates CSS linear().",
      "snappy": {
        "$value": {
          "response": 0.3,
          "damping": 0.86
        },
        "$description": "toggle, press, pill"
      },
      "smooth": {
        "$value": {
          "response": 0.45,
          "damping": 1.0
        },
        "$description": "sheets, tab switcher, drag reorder"
      },
      "bouncy": {
        "$value": {
          "response": 0.5,
          "damping": 0.72
        },
        "$description": "ONLY the Shield counter pop"
      }
    },
    "stagger": {
      "$type": "duration",
      "min": {
        "$value": "24ms"
      },
      "max": {
        "$value": "32ms"
      }
    },
    "stagger-limit": {
      "$type": "number",
      "$value": 8
    },
    "press-scale": {
      "$type": "number",
      "$value": 0.97
    },
    "bloom-scale": {
      "$type": "number",
      "$value": 0.96
    },
    "lift-distance": {
      "$type": "dimension",
      "$value": "-2px"
    },
    "rise-distance": {
      "$type": "dimension",
      "$value": "8px"
    },
    "sleep-opacity": {
      "$type": "number",
      "$value": 0.6
    },
    "toast-dismiss": {
      "$type": "duration",
      "$value": "4000ms"
    }
  }
}
