{
  "name": "scyde-browser",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "pnpm --filter @scyde/tokens build",
    "contrast": "node tools/contrast-check/index.mjs",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm tokens && pnpm -r --filter './web/apps/*' build",
    "e2e": "pnpm --filter @scyde/e2e test",
    "size": "node tools/size/check.mjs"
  },
  "devDependencies": {
    "svelte": "5.57.3",
    "vite": "8.3.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "typescript": "5.9.3",
    "svelte-check": "4.7.8",
    "vitest": "5.1.0"
  }
}
